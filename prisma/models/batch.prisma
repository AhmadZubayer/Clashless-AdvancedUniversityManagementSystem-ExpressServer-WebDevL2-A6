model Batch {
  id         String @id @default(uuid())
  code       String @unique // "23-3"
  intakeYear Int // 2023
  intakeTerm Int // 3

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students            Student[]
  registrationWindows RegistrationWindow[]

  @@map("batches")
}
